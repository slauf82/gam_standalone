GAM_DB_URL=jdbc:mariadb://localhost:3306/kopfzentruminventardb
GAM_DB_USER=root
GAM_DB_PASSWORD=
GAM_JWT_SECRET=Bitte-in-Produktion-aendern-mindestens-32-Zeichen-lang

# Optional: direkte .lbd-Datei oder Suchordner für Rechnungsadressdaten
GAM_LBD_FILE=
GAM_LBD_SEARCH_FOLDERS=./config,./daten/rechnung,.
GAM_LBD_CHARSET=UTF-8

# PDF-Archivierung und Hotfolder
GAM_PDF_ARCHIVE_ENABLED=true
GAM_PDF_ARCHIVE_FOLDER=./daten/rechnung/archiv
GAM_PDF_HOTFOLDER_ENABLED=false
GAM_PDF_HOTFOLDER_FOLDER=./daten/rechnung/hotfolder
GAM_PDF_HOTFOLDER_FILENAME_MODE=patient-number
