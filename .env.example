# GAM 2.0 lokale Testkonfiguration
GAM_DB_URL=jdbc:mariadb://localhost:3306/kopfzentruminventardb?useUnicode=true&characterEncoding=utf8&serverTimezone=Europe/Berlin
GAM_DB_USER=root
GAM_DB_PASSWORD=
GAM_JWT_SECRET=bitte-hier-ein-langes-lokales-secret-mit-mindestens-32-zeichen-setzen
GAM_LBD_FILE=./config/beispiel.lbd
GAM_LBD_SEARCH_FOLDERS=./config,./daten/rechnung,.
GAM_ZUGFERD_ENABLED=true
GAM_ZUGFERD_VALIDATE=false
GAM_LOG_LEVEL=DEBUG

# PDF-Archivierung und Hotfolder
GAM_PDF_ARCHIVE_ENABLED=true
GAM_PDF_ARCHIVE_FOLDER=./daten/rechnung/archiv
GAM_PDF_HOTFOLDER_ENABLED=false
GAM_PDF_HOTFOLDER_FOLDER=./daten/rechnung/hotfolder
GAM_PDF_HOTFOLDER_FILENAME_MODE=patient-number

# Schritt 36h: optionales sicheres DB-Auto-Setup beim Backend-Start
# false/leer = Nachfrage, true = portable MariaDB bei fehlendem localhost:3306 automatisch vorbereiten
GAM_DB_AUTO_SETUP=
GAM_DB_NAME=kopfzentruminventardb
GAM_DB_PORT=3306
GAM_DEMO_SQL=sql\beispiel_v1_7_0_anonymisiert.sql
# Optional, falls der Standard-MariaDB-Download nicht erreichbar ist:
# GAM_MARIADB_ZIP_URL=https://archive.mariadb.org/mariadb-11.4.12/winx64-packages/mariadb-11.4.12-winx64.zip

# Schritt 38g6: Direkter Bestell-E-Mailversand (optional)
# Eine Freemail-Adresse kann nicht automatisch registriert werden; meistens ist ein App-Passwort nötig.
GAM_ORDERS_MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.example.de
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=gam.bestellung@example.de
SPRING_MAIL_PASSWORD=bitte-app-passwort-eintragen
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
GAM_ORDERS_MAIL_FROM=gam.bestellung@example.de
